# --- PASTE TO RENDER ---
# NODE_ENV: Render=production, local=development
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/room4u
JWT_SECRET=change-me
OPERATOR_EMAILS=you@example.com
GOOGLE_CLIENT_ID=

# --- PAYCHANGU (payments gateway) ---
# Inline Checkout flow. Keep PAYCHANGU_ENABLED=false until the Inline code is in place.
# Keys come from PayChangu dashboard -> Settings -> API Keys & Webhooks (test mode).
PAYCHANGU_ENABLED=false
PAYCHANGU_API_URL=https://api.paychangu.com
# Test secret key, format sec-test-xxxxxxxx. Server uses it to verify payments
# (GET /verify-payment/{tx_ref}). Never expose this to the browser.
PAYCHANGU_SECRET=
# Webhook signing secret — the dashboard generates this when you create a webhook
# under API Keys & Webhooks. The public webhook URL is registered in the dashboard
# (e.g. https://<your-app>.onrender.com/api/webhooks/paychangu), not in this file.
PAYCHANGU_WEBHOOK_SECRET=
# The PUBLIC key (pub-test-...) is NOT used server-side for Inline Checkout.
# It lives in client/.env as VITE_PAYCHANGU_PUBLIC_KEY.

# --- LOCAL ONLY (npm test) ---
MONGODB_URI_TEST=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/room4u_test
