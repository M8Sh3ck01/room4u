# ============================================================
# room4u server — env template (commit-safe, placeholder values)
# Copy to .env and fill in the real values. .env is gitignored.
# ============================================================
# The variables under [RENDER + LOCAL] must ALSO be added to the
# Render dashboard → Environment Variables. The [LOCAL ONLY] block
# stays on your machine.

# ------------------------------------------------------------
# [RENDER + LOCAL] — paste these into Render's dashboard too
# ------------------------------------------------------------

# Render uses: production   local uses: development
NODE_ENV=development

# App database (deployed app + local dev share the same cluster/DB)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/room4u

# Session signing secret (use a strong random value per environment)
JWT_SECRET=change-me

# Staging only: enables /api/auth/dev. Keep false in production.
ALLOW_DEV_LOGIN=false

# Comma-separated emails granted the operator role at sign-in
OPERATOR_EMAILS=you@example.com

# Google OAuth web client id (empty until created; also needed on Render later)
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------
# [LOCAL ONLY] — do NOT add these to Render
# ------------------------------------------------------------

# Local dev port (Render sets its own PORT automatically)
PORT=4000

# Tests run against a separate DB on the same Atlas cluster
MONGODB_URI_TEST=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/room4u_test

# Campus anchor — code already defaults to these; local overrides only
CAMPUS_LAT=-11.4584
CAMPUS_LNG=34.0257
