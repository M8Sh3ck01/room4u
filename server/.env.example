# --- PASTE TO RENDER ---
# NODE_ENV: Render=production, local=development
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/room4u
JWT_SECRET=change-me
# Staging only. Keep false in production.
ALLOW_DEV_LOGIN=false
OPERATOR_EMAILS=you@example.com
GOOGLE_CLIENT_ID=

# --- PAYCHANGU (payments gateway) ---
# Set PAYCHANGU_ENABLED=true and real secrets once you have gateway credentials.
# Until then the server uses a stub link generator (no charges, no webhooks).
PAYCHANGU_ENABLED=false
PAYCHANGU_API_URL=https://api.paychangu.com
PAYCHANGU_SECRET=
PAYCHANGU_WEBHOOK_SECRET=

# --- LOCAL ONLY (npm test) ---
MONGODB_URI_TEST=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/room4u_test
