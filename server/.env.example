NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/room4u
# Tests run against a separate DB on the same Atlas cluster (or a local mongod if you have one).
MONGODB_URI_TEST=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/room4u_test
JWT_SECRET=change-me
# Dev-only sign-in (/api/auth/dev). Keep OFF (false) in production; set true only while
# Google OAuth is not configured yet. The endpoint 404s when this is false.
ALLOW_DEV_LOGIN=false
# Google OAuth web client id (create in Google Cloud Console; used to verify id_tokens + as `aud`).
# Empty in dev: the real /api/auth/google endpoint stays unavailable and the dev-only
# /api/auth/dev login is enabled instead (it 404s in production).
GOOGLE_CLIENT_ID=
OPERATOR_EMAILS=you@example.com
CAMPUS_LAT=-11.4584
CAMPUS_LNG=34.0257
