# Google OAuth web client id (same as server GOOGLE_CLIENT_ID). Empty = Google sign-in
# is unavailable in this build.
VITE_GOOGLE_CLIENT_ID=

# PayChangu Inline Checkout public key (test mode, format pub-test-xxxxxxxx).
# Same source as the server secret key: dashboard -> Settings -> API Keys & Webhooks.
# Empty = paying in this build is unavailable.
VITE_PAYCHANGU_PUBLIC_KEY=
